<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }}</title>

  {% if company.favicon %}
    <link rel="icon" href="{{ company.favicon }}">
  {% endif %}

  <link rel="stylesheet" href="/style.css">

</head>

<body>

<nav>

  <a href="/">

    {% if company.logo %}
      <img src="{{ company.logo }}"
           class="nav-logo"
           alt="{{ company.company_name }}">
    {% else %}
      <img src="/logo.png"
           class="nav-logo"
           alt="Logo">
    {% endif %}

  </a>

  <ul>

    {% for item in navigation.items %}

      <li>

        <a href="{{ item.url }}">

          {{ item.title }}

        </a>

      </li>

    {% endfor %}

  </ul>

</nav>

<main>

  {{ content | safe }}

</main>

<footer>

  <h3>{{ company.company_name }}</h3>

  {% if company.tagline %}
    <p>{{ company.tagline }}</p>
  {% endif %}

  <p>{{ company.address }}</p>

  <p>Email: {{ company.email }}</p>

  <p>Phone: {{ company.phone }}</p>

  {% if company.whatsapp %}
    <p>WhatsApp: {{ company.whatsapp }}</p>
  {% endif %}

  {% if company.office_hours %}
    <p>{{ company.office_hours }}</p>
  {% endif %}

  <div class="footer-social">

    {% if company.facebook %}
      <a href="{{ company.facebook }}" target="_blank">Facebook</a>
    {% endif %}

    {% if company.linkedin %}
      <a href="{{ company.linkedin }}" target="_blank">LinkedIn</a>
    {% endif %}

    {% if company.twitter %}
      <a href="{{ company.twitter }}" target="_blank">X</a>
    {% endif %}

    {% if company.instagram %}
      <a href="{{ company.instagram }}" target="_blank">Instagram</a>
    {% endif %}

    {% if company.youtube %}
      <a href="{{ company.youtube }}" target="_blank">YouTube</a>
    {% endif %}

  </div>

  <p>{{ company.copyright }}</p>

</footer>

</body>

</html>
