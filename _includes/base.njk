<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav>
  <img src="/logo.png" class="nav-logo">

  <ul>
    {% for item in navigation.items %}
      <li>
        <a href="{{ item.url }}">
          {{ item.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>

<main>
  {{ content | safe }}
</main>

<footer>

  <h3>{{ company.company_name }}</h3>

  <p>{{ company.address }}</p>

  <p>{{ company.email }}</p>

  <p>{{ company.phone }}</p>

  <p>{{ company.office_hours }}</p>

  <p>{{ company.copyright }}</p>

</footer>

</body>
</html>
