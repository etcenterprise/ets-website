---
layout: base.njk
title: Audit & Financial Solutions
---

<!-- ===========================
PAGE HEADER
=========================== -->

<section class="page-header">

  <div class="container">

    <h1>Audit & Financial Solutions</h1>

    <p>
      ETS provides professional auditing, accounting,
      financial management, taxation, compliance,
      risk management and business advisory services
      throughout Somalia.
    </p>

  </div>

</section>


<!-- ===========================
AUDIT SERVICES
=========================== -->

<section class="services-section">

  <div class="container">

    <h2>Our Audit Services</h2>

    <div class="cards">

      {% for item in collections.audit %}

      <div class="card">

        <h3>{{ item.data.title }}</h3>

        {% if item.data.client %}
        <p><strong>Client:</strong> {{ item.data.client }}</p>
        {% endif %}

        {% if item.data.location %}
        <p><strong>Location:</strong> {{ item.data.location }}</p>
        {% endif %}

        {{ item.templateContent | safe }}

      </div>

      {% endfor %}

    </div>

  </div>

</section>


<!-- ===========================
AUDIT TEAM
=========================== -->

<section class="team-section">

  <div class="container">

    <h2>Meet Our Audit Team</h2>

    <div class="team-grid">

      {% for member in collections.audit_team %}

      <div class="team-card">

        {% if member.data.photo %}
        <img
          src="{{ member.data.photo }}"
          alt="{{ member.data.title }}"
          class="team-photo">
        {% endif %}

        <h3>{{ member.data.title }}</h3>

        <h4>{{ member.data.position }}</h4>

        {% if member.data.experience %}
        <p><strong>Experience:</strong> {{ member.data.experience }}</p>
        {% endif %}

        {% if member.data.education %}
        <p><strong>Education:</strong> {{ member.data.education }}</p>
        {% endif %}

        {% if member.data.email %}
        <p><strong>Email:</strong> {{ member.data.email }}</p>
        {% endif %}

        {% if member.data.phone %}
        <p><strong>Phone:</strong> {{ member.data.phone }}</p>
        {% endif %}

        {% if member.data.specializations %}

        <h4>Specializations</h4>

        <ul>

          {% for skill in member.data.specializations %}

          <li>{{ skill }}</li>

          {% endfor %}

        </ul>

        {% endif %}

        {{ member.templateContent | safe }}

      </div>

      {% endfor %}

    </div>

  </div>

</section>


<!-- ===========================
CALL TO ACTION
=========================== -->

<section class="cta">

  <div class="container">

    <h2>Need Professional Audit Services?</h2>

    <p>
      Our audit professionals are ready to assist your
      organization with auditing, accounting, taxation,
      compliance, internal controls and financial advisory
      services.
    </p>

    <a href="/contact.html" class="btn">
      Contact Our Audit Team
    </a>

  </div>

</section>
