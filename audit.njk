---
layout: base.njk
title: Audit & Financial Solutions
---

<!-- HERO -->

<section class="page-header">

  <div class="container">

    <h1>Audit & Financial Solutions</h1>

    <p>
      ETS provides professional auditing, accounting,
      taxation, financial management, compliance,
      internal audit and business advisory services
      across Somalia.
    </p>

  </div>

</section>


<!-- AUDIT SERVICES -->

<section class="services-section">

  <div class="container">

    <h2>Our Audit Services</h2>

    <div class="cards">

      {% for item in collections.audit %}

      <div class="card">

        <h3>{{ item.data.title }}</h3>

        {% if item.data.client %}
        <p><strong>Client:</strong> {{ item.data.client }}</p>
        {% endif %}

        {% if item.data.location %}
        <p><strong>Location:</strong> {{ item.data.location }}</p>
        {% endif %}

        {{ item.content | safe }}

      </div>

      {% endfor %}

    </div>

  </div>

</section>


<!-- AUDIT TEAM -->

<section class="team-section">

  <div class="container">

    <h2>Meet Our Audit Team</h2>

    <div class="team-grid">

      {% for member in audit_team %}

      <div class="team-card">

        {% if member.photo %}
        <img
          src="{{ member.photo }}"
          alt="{{ member.title }}"
          class="team-photo">
        {% endif %}

        <h3>{{ member.title }}</h3>

        <h4>{{ member.position }}</h4>

        {% if member.experience %}
        <p><strong>Experience:</strong> {{ member.experience }}</p>
        {% endif %}

        {% if member.education %}
        <p><strong>Education:</strong> {{ member.education }}</p>
        {% endif %}

        {% if member.email %}
        <p><strong>Email:</strong> {{ member.email }}</p>
        {% endif %}

        {% if member.phone %}
        <p><strong>Phone:</strong> {{ member.phone }}</p>
        {% endif %}

        {% if member.specializations %}

        <h4>Specializations</h4>

        <ul>

          {% for skill in member.specializations %}
          <li>{{ skill }}</li>
          {% endfor %}

        </ul>

        {% endif %}

        {% if member.body %}
        <p>{{ member.body }}</p>
        {% endif %}

      </div>

      {% endfor %}

    </div>

  </div>

</section>


<!-- CONTACT CTA -->

<section class="cta">

  <div class="container">

    <h2>Need Professional Audit Services?</h2>

    <p>
      Contact our Audit & Financial Solutions team today
      for professional financial advice, audit services,
      compliance reviews and business consultancy.
    </p>

    <a href="/contact.html" class="btn">
      Contact Our Audit Team
    </a>

  </div>

</section>
